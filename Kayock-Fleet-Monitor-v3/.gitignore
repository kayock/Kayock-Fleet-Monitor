# Python virtual environments
.venv/
venv/
ENV/
env/

# Python caches and pytest caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Temporary files and logs
*.log
temp/
tmp/
test_output/

# Local machine configurations (exclude sensitive info)
.*/monitor_config.json
.*/ai_servers.json
.*/fleet.json

# Credentials, tokens, and API keys
.*/credentials.json
.*/api_keys.txt
.*/secrets.yaml
.*/settings.local.json

# Generated runtime data
.*/logs/
.*/cache/
